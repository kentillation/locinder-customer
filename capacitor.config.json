{
  "appId": "com.example.locinder",
  "appName": "Locinder",
  "webDir": "dist",
  "server": {
    "cleartext": true,
    "androidScheme": "https",
    "url": "https://locinder.vercel.app"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#5c3a21",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
